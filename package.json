{
  "name": "@zof-ai/github-action",
  "version": "0.1.2",
  "description": "GitHub Actions integration for local Zof change verification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "action.yml",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zof-AI/zof-github-action.git"
  },
  "homepage": "https://github.com/Zof-AI/zof-github-action#readme",
  "bugs": {
    "url": "https://github.com/Zof-AI/zof-github-action/issues"
  },
  "keywords": [
    "verification",
    "testing",
    "zof"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/action.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/action.cjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@zof-ai/cli": "0.1.2",
    "@zof-ai/evidence-spec": "0.1.1"
  },
  "private": true
}
